# Runtime region selection. The regional catalog is maintained in the root
# config.yaml file. Its current active regions are:
#   au1a (nickname: aws)
#   us1a (nickname: US1A)
# All other catalogued regions are inactive until their config.yaml entry is
# reviewed and marked active: true.
ANAPLAN_REGION=au1a
ANAPLAN_PLAYWRIGHT_REGION=au1a

# Credentials are read from the configured .env file (normally
# /home/cam/.hermes/.env), not from config.yaml. Never commit real values.
# Use the exact region prefix from config.yaml for every authentication method.

# Basic authentication — lowest priority.
AU1A_ANAPLAN_USERNAME=your-au1a-username
AU1A_ANAPLAN_PASSWORD=your-au1a-password

# Optional second active region.
# US1A_ANAPLAN_USERNAME=your-us1a-username
# US1A_ANAPLAN_PASSWORD=your-us1a-password

# OAuth2 device grant — highest priority when the client ID is configured.
# AU1A_ANAPLAN_CLIENT_ID=your-au1a-client-id
# AU1A_ANAPLAN_REFRESH_TOKEN=your-au1a-refresh-token
# US1A_ANAPLAN_CLIENT_ID=your-us1a-client-id
# US1A_ANAPLAN_REFRESH_TOKEN=your-us1a-refresh-token

# Certificate authentication — used when OAuth is unavailable.
# AU1A_ANAPLAN_CERTIFICATE_PATH=/path/to/au1a-client-cert.pem
# AU1A_ANAPLAN_PRIVATE_KEY_PATH=/path/to/au1a-client-key.pem
# AU1A_ANAPLAN_CERTIFICATE_ENCODED_DATA_FORMAT=v2
# US1A_ANAPLAN_CERTIFICATE_PATH=/path/to/us1a-client-cert.pem
# US1A_ANAPLAN_PRIVATE_KEY_PATH=/path/to/us1a-client-key.pem
# US1A_ANAPLAN_CERTIFICATE_ENCODED_DATA_FORMAT=v2

# For another region, copy the same fields and replace AU1A with the region
# key from config.yaml, for example EU1A_ANAPLAN_USERNAME. Do not use the old
# unprefixed ANAPLAN_USERNAME or ANAPLAN_PASSWORD variables; they are ignored.

# Optional remote HTTP protection and request sizing.
# ANAPLAN_MCP_HTTP_AUTH_TOKEN=your-http-token
# ANAPLAN_MCP_HTTP_BODY_LIMIT=100mb

# Playwright UI automation for operations blocked by API v2.0 limitations.
# Requires: npm install playwright && npx playwright install chromium
ANAPLAN_PLAYWRIGHT_ENABLED=false
ANAPLAN_PLAYWRIGHT_HEADLESS=true         # Set to false for visual debugging/MFA

# Optional custom instance routing for endpoints not already represented by
# the built-in instance registry. These are separate from the region-prefixed
# credential names above.
# ANAPLAN_INSTANCE=eu1
# ANAPLAN_INSTANCE_AUTH_BASE_URL=https://auth.anaplan.com
# ANAPLAN_INSTANCE_API_BASE_URL=https://api.anaplan.com
# ANAPLAN_INSTANCE_OAUTH_BASE_URL=https://eu1a.app.anaplan.com
# ANAPLAN_INSTANCE_UI_BASE_URL=https://eu1a.app.anaplan.com
