# Anaplan instance/tenant to connect to. Determines auth, API, OAuth, and Playwright UI hosts.
# Supported values: us1 (default), au1
# ANAPLAN_INSTANCE=us1

# For instances not built in, supply the endpoint overrides explicitly:
# ANAPLAN_INSTANCE=eu1
# ANAPLAN_INSTANCE_AUTH_BASE_URL=https://auth.anaplan.com
# ANAPLAN_INSTANCE_API_BASE_URL=https://api.anaplan.com
# ANAPLAN_INSTANCE_OAUTH_BASE_URL=https://eu1a.app.anaplan.com
# ANAPLAN_INSTANCE_UI_BASE_URL=https://eu1a.app.anaplan.com

# Basic Auth credentials (not OAuth)
ANAPLAN_USERNAME=your.email@example.com
ANAPLAN_PASSWORD=your_password

# Optional: ANAPLAN_MCP_HTTP_AUTH_TOKEN=***
# Optional: ANAPLAN_MCP_HTTP_BODY_LIMIT=100mb

# Playwright UI automation (for operations blocked by API v2.0 limitations)
# Enable to use browser automation as fallback for set_modelmode, create_list, create_module
# Requires: npm install playwright && npx playwright install chromium
ANAPLAN_PLAYWRIGHT_ENABLED=false
# Playwright uses the UI host resolved from ANAPLAN_INSTANCE above.
# ANAPLAN_PLAYWRIGHT_HEADLESS=true         # Set to false for visual debugging
